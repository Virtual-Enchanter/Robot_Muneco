<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_description</name>
  <version>0.0.0</version>
  <description>Descripcion URDF del muneco bipedo (2 piernas x 3 DOF) con ros2_control para Gazebo.</description>
  <maintainer email="david.collazos_her@uao.edu.co">david</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- el bloque <gazebo> del URDF usa $(find robot_simulation)/config/controllers.yaml -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
