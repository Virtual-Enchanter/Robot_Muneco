  <!-- ROS2 Control Block 
  Everything below this is new-->
  <ros2_control name="MunecoSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="Right_Hip_Roll_Joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Right_Hip_Pitch_Joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Right_Knee_Joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Left_Hip_Roll_Joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Left_Hip_Pitch_Joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Left_Knee_Joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo Block -->
  <!-- controllers.yaml vive en robot_simulation: con controller_manager de
       Jazzy, una ruta que contiene "robot_description" se descarta al pasar
       los parametros a los controladores y estos no cargan. -->
  <gazebo>
    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find robot_simulation)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>